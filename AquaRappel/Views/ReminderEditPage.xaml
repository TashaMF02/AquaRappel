<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AquaRappel.Views.ReminderEditPage"
             BackgroundColor="#B30F2650"
             Shell.NavBarIsVisible="False">

    <Grid VerticalOptions="Center" Padding="20,0">
        <Border Margin="0,34,0,0" BackgroundColor="{DynamicResource AqPaper}" Stroke="{DynamicResource AqLine}"
                StrokeThickness="1" StrokeShape="RoundRectangle 22" Padding="20,48,20,16">
            <VerticalStackLayout Spacing="14">
                <Label Text="{Binding Title}" FontFamily="BookmanDemi" FontSize="22"
                       TextColor="{DynamicResource AqInk}" HorizontalTextAlignment="Center" />

                <!-- Fréquence libre + plage horaire -->
                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsFreq}">
                    <Label Text="Me rappeler toutes les" Style="{StaticResource AqLabel}" />
                    <HorizontalStackLayout Spacing="8">
                        <Border Style="{StaticResource AqField}" WidthRequest="76" HeightRequest="48" Padding="8,0">
                            <Entry Text="{Binding Hours}" Keyboard="Numeric" MaxLength="4" HorizontalTextAlignment="Center" Style="{StaticResource AqEntry}" />
                        </Border>
                        <Label Text="h" VerticalOptions="Center" Style="{StaticResource AqBody}" />
                        <Border Style="{StaticResource AqField}" WidthRequest="76" HeightRequest="48" Padding="8,0">
                            <Entry Text="{Binding Minutes}" Keyboard="Numeric" MaxLength="4" HorizontalTextAlignment="Center" Style="{StaticResource AqEntry}" />
                        </Border>
                        <Label Text="min" VerticalOptions="Center" Style="{StaticResource AqBody}" />
                    </HorizontalStackLayout>
                    <Label Text="Entre" Style="{StaticResource AqLabel}" />
                    <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="8">
                        <TimePicker Time="{Binding From}" TextColor="{DynamicResource AqInk}" />
                        <Label Grid.Column="1" Text="et" VerticalOptions="Center" Style="{StaticResource AqBody}" />
                        <TimePicker Grid.Column="2" Time="{Binding To}" TextColor="{DynamicResource AqInk}" />
                    </Grid>
                </VerticalStackLayout>

                <!-- Heure (coucher) -->
                <VerticalStackLayout Spacing="2" IsVisible="{Binding UseTime}">
                    <Label Text="Heure du rappel" Style="{StaticResource AqLabel}" />
                    <TimePicker Time="{Binding Time}" TextColor="{DynamicResource AqInk}" />
                </VerticalStackLayout>

                <!-- Jours actifs de CE rappel -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Jours actifs" Style="{StaticResource AqLabel}" />
                    <HorizontalStackLayout Spacing="4" BindableLayout.ItemsSource="{Binding Days}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Button Text="{Binding Letter}" Style="{StaticResource AqDayButton}"
                                        WidthRequest="36" HeightRequest="36" CornerRadius="18"
                                        Command="{Binding Toggle}">
                                    <Button.Triggers>
                                        <DataTrigger TargetType="Button" Binding="{Binding IsOn}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{DynamicResource AqPrimary}" />
                                            <Setter Property="BorderColor" Value="{DynamicResource AqPrimary}" />
                                            <Setter Property="TextColor" Value="White" />
                                        </DataTrigger>
                                    </Button.Triggers>
                                </Button>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource AqError}" />
                <BoxView HeightRequest="1" Color="{DynamicResource AqLine}" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                    <Button Text="Annuler" Style="{StaticResource AqOutlineButton}" Command="{Binding CancelCommand}" />
                    <Button Grid.Column="1" Text="Enregistrer" Style="{StaticResource AqPrimaryButton}"
                            HeightRequest="48" Command="{Binding SaveCommand}" />
                </Grid>
            </VerticalStackLayout>
        </Border>

        <Border HorizontalOptions="Center" VerticalOptions="Start" WidthRequest="68" HeightRequest="68"
                StrokeShape="RoundRectangle 34" BackgroundColor="{DynamicResource AqPale}"
                Stroke="{DynamicResource AqBorder}" StrokeThickness="1" InputTransparent="True" Padding="0">
            <Image Source="{Binding IconFile}" WidthRequest="34" HeightRequest="34" />
        </Border>
    </Grid>
</ContentPage>
