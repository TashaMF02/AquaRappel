<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AquaRappel.Views.RegisterPage" BackgroundColor="{DynamicResource AqPale}" Shell.NavBarIsVisible="False">
    <ScrollView>
        <VerticalStackLayout Padding="24,40,24,24" Spacing="12">
            <Image Source="aqua_logo.svg" WidthRequest="84" HeightRequest="84" />
            <Label Text="Rejoins AquaRappel" Style="{StaticResource AqTitle}" HorizontalTextAlignment="Center" />
            <Label Text="Prénom" Style="{StaticResource AqLabel}" Margin="0,12,0,0" />
            <Border Style="{StaticResource AqField}"><Entry Text="{Binding Name}" Placeholder="Awa" Style="{StaticResource AqEntry}" /></Border>
            <Label Text="Adresse email" Style="{StaticResource AqLabel}" />
            <Border Style="{StaticResource AqField}"><Entry Text="{Binding Email}" Placeholder="awa@exemple.com" Keyboard="Email" Style="{StaticResource AqEntry}" /></Border>
            <Label Text="Mot de passe" Style="{StaticResource AqLabel}" />
            <Border Style="{StaticResource AqField}"><Entry Text="{Binding Password}" IsPassword="True" Placeholder="8 caractères, lettres et chiffres" Style="{StaticResource AqEntry}" /></Border>
            <Label Text="{Binding Error}" IsVisible="{Binding HasError}" Style="{StaticResource AqError}" />
            <Button Text="Créer mon compte" Style="{StaticResource AqPrimaryButton}" Margin="0,10,0,0" Command="{Binding RegisterCommand}" />
            <Label Text="Déjà inscrite ? Se connecter" Style="{StaticResource AqLink}" HorizontalOptions="Center">
                <Label.GestureRecognizers><TapGestureRecognizer Command="{Binding GoLoginCommand}" /></Label.GestureRecognizers>
            </Label>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
