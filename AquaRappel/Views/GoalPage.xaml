<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AquaRappel.Views.GoalPage" Title="🎯 Objectif quotidien" BackgroundColor="{StaticResource AqBg}">
    <VerticalStackLayout Padding="24" Spacing="20">
        <Label Text="Combien d'eau veux-tu boire par jour ? 💧" Style="{StaticResource AqHeading}" />
        <Border Style="{StaticResource AqCard}" BackgroundColor="{StaticResource AqPale}">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <Button Text="−" WidthRequest="56" Style="{StaticResource AqOutlineButton}" Clicked="OnMinus" />
                <Label Grid.Column="1" x:Name="GoalLabel" Text="2,0 L" FontSize="40" FontAttributes="Bold" TextColor="{StaticResource AqPrimary}" HorizontalTextAlignment="Center" VerticalOptions="Center" />
                <Button Grid.Column="2" Text="+" WidthRequest="56" Style="{StaticResource AqPrimaryButton}" Clicked="OnPlus" />
            </Grid>
        </Border>
        <Label Text="💡 Recommandation : 1,5 à 2 L par jour pour un adulte." Style="{StaticResource AqCaption}" FontSize="14" />
        <Button Text="Enregistrer ✅" Style="{StaticResource AqPrimaryButton}" Clicked="OnSave" />
    </VerticalStackLayout>
</ContentPage>
