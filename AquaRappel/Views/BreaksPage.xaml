<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AquaRappel.Views.BreaksPage" Title="Pauses" BackgroundColor="{DynamicResource AqBg}" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Border Style="{StaticResource AqHeader}">
            <VerticalStackLayout Spacing="2">
                <Label Text="Pauses" Style="{StaticResource AqHeaderTitle}" />
                <Label Text="Repose tes yeux, ils le méritent" Style="{StaticResource AqHeaderSub}" />
            </VerticalStackLayout>
        </Border>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,24" Spacing="14">
                <Border Style="{StaticResource AqCard}" BackgroundColor="{DynamicResource AqMint}" Stroke="#B2DFDB">
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Règle 20-20-20" Style="{StaticResource AqHeading}" />
                        <Label Text="Toutes les 20 minutes, regarde au loin (6 m) pendant 20 secondes." Style="{StaticResource AqCaption}" FontSize="14" />
                    </VerticalStackLayout>
                </Border>
                <Label Text="Fréquence des pauses" Style="{StaticResource AqLabel}" />
                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Text="20 min" Style="{StaticResource AqOutlineButton}" Command="{Binding SetFreqCommand}" CommandParameter="20">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding BreakFreq}" Value="20"><Setter Property="BackgroundColor" Value="{DynamicResource AqPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                    </Button>
                    <Button Grid.Column="1" Text="45 min" Style="{StaticResource AqOutlineButton}" Command="{Binding SetFreqCommand}" CommandParameter="45">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding BreakFreq}" Value="45"><Setter Property="BackgroundColor" Value="{DynamicResource AqPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                    </Button>
                    <Button Grid.Column="2" Text="1 h" Style="{StaticResource AqOutlineButton}" Command="{Binding SetFreqCommand}" CommandParameter="60">
                        <Button.Triggers><DataTrigger TargetType="Button" Binding="{Binding BreakFreq}" Value="60"><Setter Property="BackgroundColor" Value="{DynamicResource AqPrimary}" /><Setter Property="TextColor" Value="White" /></DataTrigger></Button.Triggers>
                    </Button>
                </Grid>
                <Border Style="{StaticResource AqCard}" BackgroundColor="{DynamicResource AqSun}" Stroke="#FFE082">
                    <VerticalStackLayout><Label Text="Pauses prises aujourd'hui" Style="{StaticResource AqCaption}" /><Label Text="{Binding CountText}" FontSize="32" FontFamily="BookmanDemi" TextColor="{DynamicResource AqPrimary}" /></VerticalStackLayout>
                </Border>
                <Button Text="J'ai fait ma pause" Style="{StaticResource AqPrimaryButton}" Command="{Binding BreakCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
