<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AquaRappel.Views.StatsPage" Title="Stats" BackgroundColor="{DynamicResource AqBg}" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Border Style="{StaticResource AqHeader}">
            <VerticalStackLayout Spacing="2">
                <Label Text="Stats" Style="{StaticResource AqHeaderTitle}" />
                <Label Text="Tes 7 derniers jours" Style="{StaticResource AqHeaderSub}" />
            </VerticalStackLayout>
        </Border>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,24" Spacing="14">
                <Border Style="{StaticResource AqCard}" BackgroundColor="{DynamicResource AqPale}">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto"><Label Text="Eau bue par jour" Style="{StaticResource AqHeading}" FontSize="16" /><Label Grid.Column="1" Text="{Binding AvgText}" Style="{StaticResource AqCaption}" VerticalOptions="Center" /></Grid>
                        <HorizontalStackLayout Spacing="6" HeightRequest="170" HorizontalOptions="Center" BindableLayout.ItemsSource="{Binding Bars}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate>
                                    <VerticalStackLayout VerticalOptions="End" Spacing="4">
                                        <BoxView HeightRequest="{Binding Height}" WidthRequest="30" CornerRadius="8" Color="{Binding Color}" />
                                        <Label Text="{Binding Day}" Style="{StaticResource AqCaption}" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                        <Label Text="{Binding GoalHint}" Style="{StaticResource AqCaption}" />
                    </VerticalStackLayout>
                </Border>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource AqCard}" BackgroundColor="{DynamicResource AqLilac}"><VerticalStackLayout><Label Text="Sommeil moyen" Style="{StaticResource AqCaption}" /><Label Text="{Binding SleepAvgText}" FontSize="24" FontFamily="BookmanDemi" /></VerticalStackLayout></Border>
                    <Border Grid.Column="1" Style="{StaticResource AqCard}" BackgroundColor="{DynamicResource AqMint}"><VerticalStackLayout><Label Text="Pauses écran" Style="{StaticResource AqCaption}" /><Label Text="{Binding BreaksCountText}" FontSize="24" FontFamily="BookmanDemi" /></VerticalStackLayout></Border>
                </Grid>
                <Border Style="{StaticResource AqCard}" BackgroundColor="{DynamicResource AqSun}">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto"><Label Text="Objectif atteint" Style="{StaticResource AqHeading}" FontSize="16" /><Label Grid.Column="1" Text="{Binding GoalDaysText}" FontSize="18" FontFamily="BookmanDemi" TextColor="{DynamicResource AqPrimary}" /></Grid>
                        <ProgressBar Progress="{Binding GoalProgress}" ProgressColor="{DynamicResource AqPrimary}" />
                        <Label Text="{Binding GoalMessage}" Style="{StaticResource AqCaption}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
