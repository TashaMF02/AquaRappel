<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AquaRappel.Views.HomePage" Title="Accueil" BackgroundColor="{DynamicResource AqBg}" Shell.NavBarIsVisible="False">
    <Grid RowDefinitions="Auto,*">
        <Border Style="{StaticResource AqHeader}">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                <Image Source="aqua_logo.svg" WidthRequest="64" HeightRequest="64" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                    <Label Text="{Binding Greeting}" Style="{StaticResource AqHeaderTitle}" />
                    <Label Text="Reste hydratée, championne" Style="{StaticResource AqHeaderSub}" />
                </VerticalStackLayout>
            </Grid>
        </Border>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,20,20,24" Spacing="14">
                <Border Style="{StaticResource AqCard}" BackgroundColor="{DynamicResource AqPale}" Stroke="{DynamicResource AqAccent}" StrokeThickness="2">
                    <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding OpenGoalCommand}" /></Border.GestureRecognizers>
                    <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                        <Label Text="Mon eau du jour" Style="{StaticResource AqLabel}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding AmountText}" FontSize="48" FontFamily="BookmanDemi" TextColor="{DynamicResource AqPrimary}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding GoalText}" Style="{StaticResource AqCaption}" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding GlassesText}" FontSize="24" HorizontalTextAlignment="Center" />
                        <Label Text="{Binding MessageText}" Style="{StaticResource AqBody}" FontFamily="BookmanDemi" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                    <Button Grid.Column="0" Text="150 ml" Style="{StaticResource AqOutlineButton}" Command="{Binding AddWaterCommand}" CommandParameter="150" />
                    <Button Grid.Column="1" Text="250 ml" Style="{StaticResource AqOutlineButton}" Command="{Binding AddWaterCommand}" CommandParameter="250" />
                    <Button Grid.Column="2" Text="500 ml" Style="{StaticResource AqOutlineButton}" Command="{Binding AddWaterCommand}" CommandParameter="500" />
                </Grid>
                <Button Text="Saisie rapide" Style="{StaticResource AqPrimaryButton}" Command="{Binding QuickEntryCommand}" />

                <Border Style="{StaticResource AqCard}"><Label Text="{Binding Advice}" Style="{StaticResource AqBody}" FontSize="14" /></Border>

                <Border Style="{StaticResource AqCard}" BackgroundColor="{DynamicResource AqSun}" Stroke="#FFE082">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout>
                                <Label Text="Prochain rappel" Style="{StaticResource AqCaption}" />
                                <Label Text="Glou glou ! Un verre d'eau" Style="{StaticResource AqBody}" FontFamily="BookmanDemi" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="{Binding NextReminderText}" FontSize="16" FontFamily="BookmanDemi" TextColor="{DynamicResource AqPrimary}" VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                    <Border Style="{StaticResource AqCard}" BackgroundColor="{DynamicResource AqLilac}" Stroke="#D1C4E9"><VerticalStackLayout><Label Text="Sommeil" Style="{StaticResource AqCaption}" /><Label Text="{Binding SleepText}" FontSize="24" FontFamily="BookmanDemi" /></VerticalStackLayout></Border>
                    <Border Grid.Column="1" Style="{StaticResource AqCard}" BackgroundColor="{DynamicResource AqMint}" Stroke="#B2DFDB"><VerticalStackLayout><Label Text="Pauses écran" Style="{StaticResource AqCaption}" /><Label Text="{Binding BreaksText}" FontSize="24" FontFamily="BookmanDemi" /></VerticalStackLayout></Border>
                </Grid>

                <Border Style="{StaticResource AqCard}" Padding="16,6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Mode sombre" Style="{StaticResource AqBody}" VerticalOptions="Center" />
                        <Switch Grid.Column="1" IsToggled="{Binding DarkMode}" VerticalOptions="Center" />
                    </Grid>
                </Border>
                <Button Text="Se déconnecter" Style="{StaticResource AqOutlineButton}" Command="{Binding LogoutCommand}" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
